# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=payments
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Confluent Cloud / Kafka
KAFKA_BOOTSTRAP_SERVERS=<your-bootstrap-server>
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISMS=PLAIN
KAFKA_SASL_USERNAME=<your-kafka-api-key>
KAFKA_SASL_PASSWORD=<your-kafka-api-secret>

# Schema Registry
SCHEMA_REGISTRY_URL=<your-schema-registry-url>
SCHEMA_REGISTRY_API_KEY=<your-schema-registry-api-key>
SCHEMA_REGISTRY_API_SECRET=<your-schema-registry-api-secret>

# Topics
PAYMENTS_TOPIC=<payments-topic>
ACCOUNTS_TOPIC=<accounts-topic>
FRAUD_ALERTS_TOPIC=fraud-alerts
